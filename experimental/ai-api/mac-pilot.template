<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Russian Structure Lab — Mac Ollama Pilot</title>
<style>
:root{--ink:#202b26;--muted:#64746b;--bg:#f2f0e9;--paper:#fffcf6;--line:#d8ded5;--green:#295b4c;--warn:#a16126}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 -apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN",sans-serif}
main{max-width:930px;margin:auto;padding:24px 16px 72px}header{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}
h1{font-size:27px;font-weight:680;margin:0;line-height:1.3}h2{font-size:17px;margin:0 0 8px}
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:50px;border:1px solid #c1d5c9;background:#e9f3ec;color:var(--green);padding:6px 12px;font-size:12px;font-weight:650}
.lead{color:var(--muted);font-size:13px}.panel{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:18px;margin-top:15px;box-shadow:0 2px 8px #22362908}
label{display:block;font-weight:680;margin-bottom:8px}textarea{width:100%;font:20px/1.7 Georgia,serif;padding:14px;border-radius:12px;border:1px solid #b8c7bd;background:white;color:var(--ink);resize:vertical;min-height:142px}
textarea:focus,button:focus-visible,a:focus-visible{outline:3px solid #7aaf94;outline-offset:2px}
button,.link{border:1px solid var(--line);border-radius:12px;background:white;color:var(--ink);cursor:pointer;padding:10px 14px;text-decoration:none;font:inherit;font-weight:650}
button.primary{background:var(--green);color:#fff;border-color:var(--green)}
button:disabled{opacity:.5;cursor:not-allowed}.buttons{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px;align-items:center}
#output{font:12px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;min-height:160px}
#message{padding:9px 0;min-height:34px;color:var(--muted)}#message.bad{color:#a23d24}#message.good{color:#255a46}
.stats{display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
small{font-size:12px;color:var(--muted)}.note{border-left:3px solid #aa8c58;padding:6px 0 6px 13px;font-size:12px;color:#575448}
.preview{white-space:pre-wrap;line-height:1.7;font-family:Georgia,serif;font-size:17px;margin:12px 0}
@media(max-width:600px){main{padding:15px 11px 45px}h1{font-size:23px}.panel{padding:13px}textarea{font-size:18px}}
</style>
</head>
<body>
<main>
<header>
<div>
<h1>Я · Mac Ollama Studio</h1>
<div class="lead">Russian Structure Lab / Mac専用のローカル解析 · モデルとプロンプトの比較</div>
</div>
<span class="pill" id="connection">Mac · ローカル接続</span>
</header>
<p class="lead">ChatGPTを精密解析の主力として残しながら、Mac上のOllamaで教材を試作します。この画面ではChatGPTを自動で呼び出しません。</p>
<section class="panel">
<h2>1 · ロシア語の文章</h2>
<label for="original">解析したい原文を貼り付け</label>
<textarea id="original" lang="ru" spellcheck="false" placeholder="Я вчера не купил свою интересную книгу."></textarea>
<div class="buttons">
<button id="sample" type="button">例文を入れる</button>
<button class="primary" id="analyze" type="button">MacのOllamaで解析</button>
</div>
<p id="message" role="status" aria-live="polite">文章を入力して「解析」を押してください。</p>
<small>入力した原文と解析結果はサーバー側に保存されません。端末上のモデルで処理し、外部クラウドへ送る機能はありません。</small>
</section>
<section class="panel" id="result-panel" hidden>
<h2>2 · 解析結果（教材JSON v1.0）</h2>
<div class="stats" id="stats"></div>
<p class="note">形式チェックは通過しました。ただし格・体・アクセント・訳の言語学的な正確性は未確認です。教材に登録する前に内容を点検してください。</p>
<div id="preview" class="preview"></div>
<label for="output">検証済みJSON</label>
<textarea id="output" readonly spellcheck="false" aria-label="生成された教材JSON"></textarea>
<div class="buttons">
<button id="copy" class="primary" type="button">JSONをコピー</button>
<button id="download" type="button">JSONファイル保存</button>
<a class="link" href="https://ohganed.github.io/russian-structure-lab/ai-material.html" target="_blank" rel="noopener noreferrer">AI Materialを開く</a>
</div>
<small>AI Materialでは「＋ 教材」→「Generated JSON」に貼り付け→「読み込み」。MacとiPhoneのデータは自動同期されません。</small>
</section>
<section class="panel">
<h2>ChatGPTの高精度解析もそのまま利用</h2>
<p class="lead">複雑な動詞の体や、格の解釈、語形成の検証などは、今までどおりChatGPTで教材JSONを作成できます。上のリンクからAI Materialを開いて従来の解析プロンプトをコピーしてください。</p>
<p class="note">このローカル画面は試験版です。解析処理中はMacのOllamaが起動している必要があります。作業を終えたらターミナルで <code>Control+C</code> を押して終了してください。</p>
</section>
</main>
<script nonce="__RSL_NONCE__">
"use strict";
const token=__RSL_TOKEN_JSON__;
const $=id=>document.getElementById(id);
let generated=null;
const say=(message,kind="")=>{$("message").textContent=message;$("message").className=kind;};
$("sample").addEventListener("click",()=>{$("original").value="Я вчера не купил свою интересную книгу.";});
$("analyze").addEventListener("click",async()=>{
  const original=$("original").value;
  if(!original.trim()){say("ロシア語の文章を入力してください。","bad");return;}
  $("analyze").disabled=true;
  $("result-panel").hidden=true;
  generated=null;
  say("Ollamaで解析しています。長文は時間がかかる場合があります。");
  try{
    const response=await fetch("/v1/analyze",{
      method:"POST",
      headers:{"Authorization":"Bearer "+token,"Content-Type":"application/json"},
      body:JSON.stringify({originalText:original}),cache:"no-store"
    });
    const data=await response.json();
    if(!response.ok)throw new Error(data.detail||data.error||("HTTP "+response.status));
    generated=data;
    $("output").value=JSON.stringify(data,null,2);
    const sentences=Array.isArray(data.sentences)?data.sentences:[];
    const words=sentences.reduce((n,s)=>n+(s.words?.length||0),0);
    $("stats").textContent="文章 "+sentences.length+"件 · 単語 "+words+"件 · モデル: "+(data.analysisMeta?.model||"不明")+" · プロンプト: "+(data.analysisMeta?.promptVersion||"不明")+" · JSON schema "+data.schemaVersion;
    $("preview").textContent=sentences.map(s=>s.text).join("\n");
    $("result-panel").hidden=false;
    say("形式検証に合格しました。JSONをコピーしてAI Materialへ取り込めます。","good");
  }catch(error){
    say("解析結果を採用できませんでした: "+String(error.message||error),"bad");
  }finally{$("analyze").disabled=false;}
});
$("copy").addEventListener("click",async()=>{
  if(!generated)return;
  try{
    await navigator.clipboard.writeText($("output").value);
    say("JSONをコピーしました。AI MaterialのGenerated JSON欄に貼り付けてください。","good");
  }catch{say("コピーできませんでした。JSON欄を選択して手動でコピーしてください。","bad");}
});
$("download").addEventListener("click",()=>{
  if(!generated)return;
  const blob=new Blob([$("output").value],{type:"application/json;charset=utf-8"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;a.download="rsl-ollama-material.json";a.click();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
});
fetch("/health",{cache:"no-store"}).then(r=>r.json()).then(d=>{
  $("connection").textContent="Mac / "+(d.model||"Ollama")+" / "+(d.promptVersion||"旧プロンプト");
}).catch(()=>{$("connection").textContent="Mac · 接続を確認してください";});
</script>
</body>
</html>
